# -------------
# ENV variables
# -------------

# ETSI_020_REF_IMPL_ROOT_CERT - Root cert
# ETSI_020_REF_IMPL_PRIVATE_KEY - Server private key
# ETSI_020_REF_IMPL_PUBLIC_CERT - Server public cert
# ETSI_020_REF_IMPL_PORT_NUM - Port number to listen on.
# ETSI_020_REF_IMPL_IP_ADDR - IP address to bind to.
# ETSI_020_REF_IMPL_SEND_EXT_KEYS_ENABLE - Whether to enable the ext_key dispatching subsystem of the ref impl server.
# ETSI_020_REF_IMPL_SEND_EXT_KEYS_INTERVAL_SECONDS - The duration in between `ext_key` requests.
# ETSI_020_REF_IMPL_SEND_EXT_KEYS_BASE_URL - The ext_keys endpoint to send requests to.
# ETSI_020_REF_IMPL_SEND_EXT_KEYS_ACK_CALLBACK_URL - The ack callback url to use.
# ETSI_020_REF_IMPL_INTRA_NETWORK_SAE_IDS - Which SAE IDs originate from within our network.
# ETSI_020_REF_IMPL_THIRD_PARTY_SAE_IDS - Which SAE IDs can be relayed by this key gateway.

ALICE_SAES = encryptor_1,encryptor_2,encryptor_3
BOB_SAES = 3rd_party_encryptor_1,3rd_party_encryptor_2,3rd_party_encryptor_3

# -----
# Alice
# -----

A_ETSI_020_REF_IMPL_ROOT_CERT = certificates/root.pem
A_ETSI_020_REF_IMPL_PRIVATE_KEY = certificates/gateway.key
A_ETSI_020_REF_IMPL_PUBLIC_CERT = certificates/gateway.pem
A_ETSI_020_REF_IMPL_PORT_NUM = 8888
A_ETSI_020_REF_IMPL_IP_ADDR = 127.0.0.1
A_ETSI_020_REF_IMPL_SEND_EXT_KEYS_ENABLE = true
A_ETSI_020_REF_IMPL_SEND_EXT_KEYS_INTERVAL_SECONDS = 10
A_ETSI_020_REF_IMPL_SEND_EXT_KEYS_BASE_URL = https://localhost:8889/
A_ETSI_020_REF_IMPL_SEND_EXT_KEYS_ACK_CALLBACK_URL = https://localhost:$(A_ETSI_020_REF_IMPL_PORT_NUM)/kmapi/v1/ext_keys/ack
A_ETSI_020_REF_IMPL_INTRA_NETWORK_SAE_IDS = $(ALICE_SAES)
A_ETSI_020_REF_IMPL_THIRD_PARTY_SAE_IDS = $(BOB_SAES)

# ---
# Bob
# ---

B_ETSI_020_REF_IMPL_ROOT_CERT = certificates/root.pem
B_ETSI_020_REF_IMPL_PRIVATE_KEY = certificates/gateway_2.key
B_ETSI_020_REF_IMPL_PUBLIC_CERT = certificates/gateway_2.pem
B_ETSI_020_REF_IMPL_PORT_NUM = 8889
B_ETSI_020_REF_IMPL_IP_ADDR = 127.0.0.1
B_ETSI_020_REF_IMPL_SEND_EXT_KEYS_ENABLE = true
B_ETSI_020_REF_IMPL_SEND_EXT_KEYS_INTERVAL_SECONDS = 30
B_ETSI_020_REF_IMPL_SEND_EXT_KEYS_BASE_URL = https://localhost:8888/
B_ETSI_020_REF_IMPL_SEND_EXT_KEYS_ACK_CALLBACK_URL = https://localhost:$(B_ETSI_020_REF_IMPL_PORT_NUM)/kmapi/v1/ext_keys/ack
B_ETSI_020_REF_IMPL_INTRA_NETWORK_SAE_IDS = $(BOB_SAES)
B_ETSI_020_REF_IMPL_THIRD_PARTY_SAE_IDS = $(ALICE_SAES)
